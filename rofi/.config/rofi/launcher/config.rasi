configuration {
    modi:                "drun,run";
    show-icons:          true;
    icon-theme:          "Papirus";
    display-drun:        "";
    display-run:         "";
    drun-display-format: "{name}";
    steal-focus:         false;
    matching:            "regex";
    fixed-height:        true;
}

@import ".config/rofi/shared/colors.rasi"
@import ".config/rofi/shared/fonts.rasi"

/* ── Palette ──────────────────────────────────────────────────────────── */
* {
    bg0:     @surface;
    bg1:     @surface-container;
    bg2:     @surface-container;
    fg0:     @on-surface;
    fg1:     @on-surface;
    fg2:     @on-surface;
    accent:  @primary;
    urgent:  @error;
    cyan:    @secondary;

    background-color: transparent;
    text-color:       @on-surface;
}

/* ── Window ───────────────────────────────────────────────────────────── */
window {
    width:            520px;
    background-color: @bg0;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    4px;
    padding:          0;
    cursor:           "default";
}

/* ── Main box ─────────────────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0;
    padding:          12px;
}

/* ── Input bar ────────────────────────────────────────────────────────── */
inputbar {
    background-color: @bg1;
    padding:          10px 14px;
    margin:           0 0 10px 0;
    border-radius:    4px;
    children:         [ textbox-prompt-colon, entry ];
    spacing:          6px;
}

textbox-prompt-colon {
    expand:           false;
    str:              "";
    text-color:       @accent;
    background-color: transparent;
}

entry {
    background-color:  transparent;
    text-color:        @fg0;
    placeholder:       "Search apps…";
    placeholder-color: @fg2;
    cursor:            text;
}

/* ── List view ────────────────────────────────────────────────────────── */
listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          4px;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    fixed-height:     false;
    cursor:           "default";
}

/* ── List elements ────────────────────────────────────────────────────── */
element {
    background-color: transparent;
    text-color:       @fg0;
    border-radius:    4px;
    padding:          8px 12px;
    spacing:          8px;
    orientation:      horizontal;
    cursor:           pointer;
}

element normal.normal    { background-color: transparent; text-color: @fg0;    }
element normal.urgent    { background-color: transparent; text-color: @urgent; }
element normal.active    { background-color: transparent; text-color: @cyan;   }
element alternate.normal { background-color: transparent; text-color: @fg0;    }
element alternate.urgent { background-color: transparent; text-color: @urgent; }
element alternate.active { background-color: transparent; text-color: @cyan;   }

element selected.normal  { background-color: @accent; text-color: @on-primary;   }
element selected.urgent  { background-color: @urgent; text-color: @on-error;     }
element selected.active  { background-color: @cyan;   text-color: @on-secondary; }

element-icon {
    background-color: transparent;
    size:             24px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}
