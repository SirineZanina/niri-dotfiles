prefer-no-csd

environment {
    QT_QPA_PLATFORM "wayland"
}


hotkey-overlay {
  skip-at-startup
}

// screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d %H-%M-%S.png"

cursor {
  xcursor-theme "Bibata-Modern-Ice"
  xcursor-size 24
  hide-when-typing
  hide-after-inactive-ms 3000
}

input {
  keyboard {
    xkb {
      layout "us"
    }

    repeat-rate 100
    repeat-delay 300
  }

  touchpad {
  tap
  natural-scroll
  accel-speed 0.7        // match mouse
  accel-profile "adaptive"
  scroll-factor 2.0
  scroll-method "two-finger"
}
mouse {
  accel-speed 0.8
  accel-profile "adaptive"
  scroll-factor 2.0
}

  focus-follows-mouse
}

output "eDP-1" {
    mode "1920x1080@144.149"
    position x=1280 y=0
}
output "HDMI-A-2" {
    mode "1680x1050@59.954"
    position x=3200 y=0
}

layout {
  gaps 6
  center-focused-column "never"

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }

  default-column-width { proportion 0.5; }

  focus-ring {
    on
    width 1
    active-gradient from="#c4a7e7" to="#9ccfd8" angle=45 relative-to="workspace-view"
    inactive-color "#6e6a86"
  }

 // border {
   // on
   // width 1

//  active-gradient from="#4A9EAF" to="#A8D8EA" angle=45 relative-to="workspace-view"
  //inactive-color "#1C3A42"   // dark stormy teal for unfocused windows
  //}

  shadow {
    off
    softness 30
    spread 5
    offset x=0 y=10
    color "#0007"
  }
  struts {
    left 5
    right 5
    top 0
    bottom 0
  }
}

debug {
    honor-xdg-activation-with-invalid-serial
}

blur {
  passes 5
  offset 5
  noise 0.02
  saturation 1.5
}

spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-at-startup "hypridle"
spawn-at-startup "noctalia"
spawn-at-startup "protonvpn-app"

xwayland-satellite {
    path "xwayland-satellite"
}

animations {
}

overview {
  zoom 0.40
  backdrop-color "#ffffff"

}

window-rule {
  geometry-corner-radius 2
  focus-ring {
    on
    width 1
    active-gradient from="#c4a7e7" to="#9ccfd8" angle=45 relative-to="workspace-view"
    inactive-color "#6e6a86"
  }
  clip-to-geometry true
  // open-maximized true
}

window-rule {
  match app-id="btop"
  open-maximized true
}

window-rule {
  match app-id="^kitty$"
  match app-id="^Alacritty$"
  background-effect {
    blur true
  }
}

window-rule {
  match title="^Picture-in-Picture$"
  match title=r#"^Picture in picture$"#
  match app-id="org.kde.kdeconnect.daemon"
  geometry-corner-radius 24
  open-floating true
  open-focused false
  default-floating-position x=20 y=20 relative-to="bottom-right"
  default-column-width { proportion 0.22; }
  default-window-height { proportion 0.22; }
  shadow {
        on
        softness 60
        spread 10
        offset x=0 y=10
        draw-behind-window true
        color "#000000"
    }
}

layer-rule {
  match namespace="^rofi$"
  geometry-corner-radius 50
  background-effect {
    blur true
  }
}

layer-rule {
  match namespace="^waybar$"
  match namespace="quickshell"
  match namespace="^logout_dialog$"
  background-effect {
    blur true
  }
}

window-rule {
  match app-id="Brave-origin-beta"
  match app-id="librewolf"
  match app-id="Helium"
  // match app-id="foot"
  match app-id="com.mitchellh.ghostty"
  open-maximized true
}

window-rule {
  match app-id="jetbrains-idea"
  open-fullscreen true
}

window-rule {
  match app-id="org.kde.kdeconnect.app"
  match app-id="localsend"
  open-floating true
  open-focused true
  default-floating-position x=20 y=20 relative-to="bottom-right"
  default-column-width { fixed 400; }
  default-window-height { proportion 0.72; }
}

window-rule {
  match title="^save to$"
  match title="^Authenticate$"
  match title="^Library$"
  match title="^File Upload$"
  open-floating true
  geometry-corner-radius 24
  default-column-width { fixed 1000; }
  default-window-height { fixed 600; }
  shadow {
        on
        softness 60
        spread 10
        offset x=0 y=10
        draw-behind-window true
        color "#000000"
    }
}

window-rule {
  match app-id="yazi"
  open-maximized true
}

window-rule {
  match app-id="bluetui"
  match app-id="pulsemixer"
  match app-id="nmtui"
  match app-id="dashboard"
  match app-id="ncdu"
  match app-id="battery"
  match app-id="sensors"
  match app-id="aichat"
  open-floating true
  open-focused true
  default-floating-position x=20 y=20 relative-to="bottom-right"
  default-column-width { proportion 0.50; }
  default-window-height { proportion 0.55; }
  shadow {
        on
        softness 60
        spread 10
        offset x=0 y=10
        draw-behind-window true
        color "#000000"
    }
}

window-rule {
  match app-id="dashboard"
  open-floating true
  open-focused true
  default-floating-position x=20 y=20 relative-to="bottom-right"
  default-column-width { proportion 0.33; }
  default-window-height { proportion 0.32; }
  shadow {
        on
        softness 60
        spread 5
        offset x=0 y=10
        draw-behind-window true
        color "#000000"
    }
}

// Rules preserved from the previous config because they are not represented above.

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"(?i)pavucontrol|blueman-manager|nm-connection-editor"#
    open-floating true
}

window-rule {
  match app-id="thunar"
  opacity 0.9
}

// Noctalia v5 settings window
window-rule {
    match app-id="dev.noctalia.Noctalia.Settings"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    background-effect {
        blur true
        xray true
    }
}

// Noctalia v5 layer rules
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

binds {
    // ── Hotkey Overlay ─────────────────────────────────────────
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ── Apps ───────────────────────────────────────────────────
    Mod+Return  hotkey-overlay-title="Terminal: kitty"        { spawn "kitty"; }
    Mod+B       hotkey-overlay-title="Browser: brave"         { spawn "brave"; }
    Mod+E       hotkey-overlay-title="File Manager: thunar"   { spawn "thunar"; }
    Mod+M       hotkey-overlay-title="Chat: discord"          { spawn "discord"; }
    Mod+G       hotkey-overlay-title="System Monitor: btop"   { spawn-sh "kitty --single-instance --class btop -e btop"; }
    Mod+X       hotkey-overlay-title="Music: cmus"            { spawn-sh "kitty --single-instance --class cmus -e cmus"; }
    Mod+Y       hotkey-overlay-title="Network: nmtui"         { spawn-sh "kitty --single-instance --class nmtui -e nmtui"; }
    Mod+A       hotkey-overlay-title="Bluetooth: bluetui"     { spawn-sh "kitty --single-instance --class bluetui -e bluetui"; }
    Mod+Z       hotkey-overlay-title="Localsend"              { spawn-sh "pkill localsend || localsend"; }
    Mod+Alt+C   hotkey-overlay-title="Color Picker"           { spawn "hyprpicker" "-a"; }

    // ── Noctalia Panels ────────────────────────────────────────
    Mod+Space   hotkey-overlay-title="App Launcher"           { spawn-sh "~/.config/rofi/launcher/launcher.sh"; }
 // Mod+Space  hotkey-overlay-title="App Launcher"  { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+W       hotkey-overlay-title="Wallpaper Picker"       { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+S       hotkey-overlay-title="Noctalia Settings"      { spawn-sh "noctalia msg settings-toggle"; }
    Mod+N       hotkey-overlay-title="Control Center"         { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+P       hotkey-overlay-title="Display Layout"         { spawn-sh "~/.config/rofi/displaymenu/displaymenu.sh"; }

    // ── Utilities ──────────────────────────────────────────────
    Mod+Shift+C hotkey-overlay-title="Clipboard"              { spawn-sh "~/.config/rofi/clipboard/clipboard.sh"; }
    Mod+Delete  hotkey-overlay-title="Wipe Clipboard"         { spawn-sh "cliphist wipe"; }

    // ── Session ────────────────────────────────────────────────
    Mod+Escape  hotkey-overlay-title="Session Menu"           { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+F12     hotkey-overlay-title="Lock Screen"            { spawn "hyprlock"; }
    Alt+O       repeat=false hotkey-overlay-title="Shutdown"  { spawn "noctalia" "msg" "session" "shutdown"; }
    Alt+R       repeat=false hotkey-overlay-title="Reboot"    { spawn "noctalia" "msg" "session" "reboot"; }
    Alt+S       repeat=false hotkey-overlay-title="Suspend"   { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
    Mod+Shift+E hotkey-overlay-title="Logout"                 { spawn "noctalia" "msg" "session" "logout"; }
    Mod+Shift+P hotkey-overlay-title="Monitors Off"           { power-off-monitors; }

    // ── Screenshots ────────────────────────────────────────────
    Print       repeat=false hotkey-overlay-title="Screenshot: Full"   { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Alt+Print   repeat=false hotkey-overlay-title="Screenshot: Region" { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+Shift+S repeat=false hotkey-overlay-title="Screenshot: Region + Edit" { spawn-sh "grim -t ppm -g \"$(slurp -o -d -c '#eb6f92ff' -b '#191724aa')\" - | satty -f - --copy-command wl-copy --early-exit --output-filename \"$(xdg-user-dir PICTURES)/Screenshots/Screenshot_$(date '+%Y-%m-%d_%H-%M-%S').png\""; }


    // ── Window Management ──────────────────────────────────────
    Mod+Q repeat=false { close-window; }
    Mod+V              { toggle-window-floating; }
    Mod+Shift+V        { switch-focus-between-floating-and-tiling; }
    Mod+O repeat=false { toggle-overview; }
    Mod+T              { toggle-column-tabbed-display; }
    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ── Focus (HJKL + Arrows) ──────────────────────────────────
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // ── Move Windows (Ctrl+HJKL) ───────────────────────────────
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // ── Monitor Focus (Shift+HJKL) ─────────────────────────────
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    // ── Move to Monitor (Shift+Ctrl+HJKL) ─────────────────────
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // ── Workspaces ─────────────────────────────────────────────
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Tab            { focus-workspace-previous; }
    Mod+Ctrl+U         { move-window-to-workspace-down; }
    Mod+Ctrl+I         { move-window-to-workspace-up; }
    Mod+Shift+U        { move-workspace-down; }
    Mod+Shift+I        { move-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // ── Column / Window Layout ─────────────────────────────────
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }
    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+Ctrl+F       { expand-column-to-available-width; }
    Mod+Shift+R      { switch-preset-column-width; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }
    Mod+C            { center-column; }
    Mod+Ctrl+C       { center-visible-columns; }
    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }
    Mod+Alt+H        { set-column-width "-10%"; }
    Mod+Alt+L        { set-column-width "+10%"; }
    Mod+Alt+K        { set-window-height "-10%"; }
    Mod+Alt+J        { set-window-height "+10%"; }
    Mod+Alt+Ctrl+H   { set-window-width "-10%"; }
    Mod+Alt+Ctrl+L   { set-window-width "+10%"; }
    Mod+Alt+Ctrl+K   { set-window-height "-10%"; }
    Mod+Alt+Ctrl+J   { set-window-height "+10%"; }

    // ── Scroll ─────────────────────────────────────────────────
    Mod+WheelScrollDown           cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp             cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown      cooldown-ms=150 { move-window-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp        cooldown-ms=150 { move-window-to-workspace-up; }
    Mod+Shift+WheelScrollDown     { focus-column-right; }
    Mod+Shift+WheelScrollUp       { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }
    Mod+WheelScrollRight          { focus-column-right; }
    Mod+WheelScrollLeft           { focus-column-left; }
    Mod+Ctrl+WheelScrollRight     { move-column-right; }
    Mod+Ctrl+WheelScrollLeft      { move-column-left; }

    // ── Media Keys ─────────────────────────────────────────────
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1.2 @DEFAULT_AUDIO_SINK@ 10%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-"; }
    XF86AudioMute        repeat=false allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     repeat=false allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

}
